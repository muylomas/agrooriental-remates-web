extends ./home-baseHTML.pug

//- Home cuando hay más de un remate activo: un banner por remate con su botón
//- para entrar. Cada remate se ve en /remate/:id (views/cattle/remate.pug).
block content
  link(href=asset('/remate/styles.css'), rel='stylesheet', type='text/css')
  style.
    /* Ocupa al menos todo el alto de la pantalla con el contenido centrado:
       con pocas tarjetas, el footer queda debajo y solo se ve al bajar. */
    .remates-choice {
      max-width: 1100px;
      margin: 0 auto;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .remates-title { text-align: center; margin-bottom: 2rem; }
    .remates-title h1 {
      color: #ffffff;
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
      margin: 0;
    }
    .remates-title h1::after {
      content: "";
      display: block;
      width: 64px;
      height: 4px;
      margin: 12px auto 0;
      border-radius: 2px;
      background: #4e7b44;
    }
    .remates-title p {
      color: rgba(255, 255, 255, .7);
      font-size: 1rem;
      margin: 12px 0 0;
    }
    @media (min-width: 768px) {
      .remates-title h1 { font-size: 2.6rem; }
    }
    .remate-option { background: #1a1a1a; border-radius: 8px; overflow: hidden; }
    .remate-option a.remate-option-banner { display: block; }

    /* Mismo formato que los botones de acción de los lotes (Ofertar, Ver lote):
       ver "#remate-lotes .card .btn" y ".aoc-lot-offer .btn.bid-action-button"
       en /remate/styles.css. */
    .remate-option-actions { display: flex; gap: 10px; }
    .remate-option-actions .btn {
      flex: 1 1 0;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 45px;
      padding: 0 16px;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1;
      border-radius: 10px;
      box-shadow: 0 3px 8px rgba(0, 0, 0, .35);
      transition: transform .1s ease, box-shadow .1s ease;
    }
    .remate-option-actions .btn:active {
      transform: translateY(1px);
      box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
    }
    .remate-option-actions .btn i { font-size: 1.5rem; margin-right: 6px; }
    @media (min-width: 768px) {
      .remate-option-actions { flex: 0 0 auto; min-width: 380px; }
    }

  .content-wrapper.bg-agrooriental.p-0.m-0
    .remates-choice.px-3.py-5
      .remates-title
        h1 Remates activos

      each auctionItem in auctions
        - const auctionUrl = '/remate/' + auctionItem.id
        .remate-option.mb-4
          a.remate-option-banner(href=auctionUrl, title=auctionItem.name)
            img.mobile-only.w-100(alt=auctionItem.name, src=auctionItem.bannerMobile)
            img.desktop-only.w-50.mx-auto(alt=auctionItem.name, src=auctionItem.bannerDesktop)
          .d-md-flex.justify-content-between.align-items-center.p-3
            .text-white.mb-3.mb-md-0.me-md-3
              h4.m-0= auctionItem.name
              if(auctionItem.lotsCount)
                small #{auctionItem.lotsCount} #{auctionItem.lotsCount == 1 ? 'lote' : 'lotes'}
            .remate-option-actions
              if(auctionItem.catalog)
                a.btn.btn-danger(href=auctionItem.catalog, target="_blank")
                  i.mdi.mdi-file-pdf
                  | Catálogo
              a.btn.bid-action-button(href=auctionUrl)
                | Ir al remate

    include remate-includes/footer.pug
