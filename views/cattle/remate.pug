extends ./home-baseHTML.pug

block content 
  link(href=asset('/remate/styles.css'), rel='stylesheet', type='text/css')
  link(href='/vendors/jquery_toast/jquery.toast.min.css', rel='stylesheet', type='text/css')
  script(src='https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js')
  script(src='https://code.jquery.com/ui/1.14.1/jquery-ui.min.js')

  .content-wrapper.bg-agrooriental.p-0.m-0

    //- Sección "Remate en Vivo" (transmisión YouTube + contacto WhatsApp).
    //- TEMPORAL: habilitada solo para el cliente Id=1 (Martin López) mientras
    //- se prueba; sacar el `if(userId == 1)` para habilitarla a todos los
    //- clientes una vez validada.
    if(userId == 1)
      link(rel='preconnect', href='https://fonts.googleapis.com')
      link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
      link(rel='stylesheet', href='https://fonts.googleapis.com/css?family=Poppins:400,600,700')

      -
        // TODO: actualizar antes de cada remate (o cablear a un campo del
        // panel de administración si se agrega uno para el remate activo).
        var remateEnVivoVideoId = 'rc2R8ACPgsU';
        var remateEnVivoWhatsappCinthia = '59899419545';
        var remateEnVivoWhatsappCamilo = '59899492041';

      section.remate-en-vivo
        .remate-en-vivo__badge
          span.remate-en-vivo__dot
          span.remate-en-vivo__badge-text En vivo
        div
          h2.remate-en-vivo__title Remate en vivo
          p.remate-en-vivo__subtitle Seguí la transmisión en directo por YouTube y consultá por WhatsApp.
        .remate-en-vivo__main
          .remate-en-vivo__video-wrap
            iframe(src=`https://www.youtube.com/embed/${remateEnVivoVideoId}`, title="Transmisión en vivo del remate", allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture", allowfullscreen)
          .remate-en-vivo__contacts
            a.remate-en-vivo__wa-btn(href=`https://wa.me/${remateEnVivoWhatsappCinthia}`, target="_blank", rel="noopener")
              svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="#ffffff", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round")
                path(d="M4 20l1.4-4.2A8 8 0 1 1 8.8 19L4 20Z")
                path(d="M8.6 9.6c.2 1.6 1.5 3.4 2.6 4.4 1.1 1 2.9 2 4.4 2.1")
              span Escribir a Cinthia por WhatsApp
            a.remate-en-vivo__wa-btn(href=`https://wa.me/${remateEnVivoWhatsappCamilo}`, target="_blank", rel="noopener")
              svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="#ffffff", stroke-width="1.7", stroke-linecap="round", stroke-linejoin="round")
                path(d="M4 20l1.4-4.2A8 8 0 1 1 8.8 19L4 20Z")
                path(d="M8.6 9.6c.2 1.6 1.5 3.4 2.6 4.4 1.1 1 2.9 2 4.4 2.1")
              span Escribir a Camilo por WhatsApp

    if(auctions.length)
      each auctionItem in auctions
        include remate-includes/header.pug 
        
        .row.mb-2
          .col-12.position-relative(style="background:#1a1a1a")
            img.mobile-only.w-100(title=auctionItem.name, src=auctionItem.bannerMobile)
            img.desktop-only.w-50.mx-auto(title=auctionItem.name, src=auctionItem.bannerDesktop)
            .position-absolute.top-0.end-0.pe-2.pt-2(onclick="auctionInfo()")
                i.mdi.mdi-information-outline.icon-md.text-warning

        #remate-lotes.row.portfolio-grid
          #filtros-remate.d-none
            card.border-0.d-flex.align-items-center.text-white.m-4.my-2
              .d-flex.justify-content-between.w-100
                .d-flex.align-items-center
                    h4.m-0.me-3
                      | Lote:
                    input.form-control.text-center.fs-4.p-2(type="number", name="filtro-lot-id", value="" style="width: 70px;")
                    button.btn.bid-action-button.fs-5(onclick="goToLotById()")
                      | Ir
                .d-flex.justify-content-between.align-items-end
                  if(auctionItem.catalog)
                    a.btn.btn-danger.btn-icon-text.p-1(href=auctionItem.catalog, target="_blank")
                      i.mdi.mdi-file-pdf.btn-icon-prepend.mdi-36px
                      | Catálogo

          #aoc-carousel-wrap.aoc-carousel-wrap.d-none
            h3.aoc-carousel-title.mt-2 🔥🔥 DESTACADOS AHORA 🔥🔥
            .aoc-carousel-body
              #aocTrack.aoc-carousel-track
              #aocDots.aoc-dots

        #loading-lots.pt-5.pb-3.m-0
          h3.text-center.text-white Buscando lotes del remate...
          .loading-image.mx-auto
            img.w-100(src="https://agro-oriental-remates.s3.us-west-1.amazonaws.com/web/images/transparent-pixel.png")
    else  
      #loading-lots.m-0(style={"min-height":"60vh", "padding-top":"10%"})
        h3.text-center.text-white Buscando lotes del remate...
        .loading-image.mx-auto
          img.w-100(src="https://agro-oriental-remates.s3.us-west-1.amazonaws.com/web/images/transparent-pixel.png")


    footer.bg-dark.text-white.p-4.pt-5
      h4.mb-4
        b Contáctenos
      p 
        span.fs-6 
          b Teléfono
        | :
        br
        | (+598) 2604 3036, (+598) 99 647 561
      p 
        span.fs-6 
          b Dirección
        | :
        br
        | Gral. Domingo French 1948,
        br
        | Montevideo, 
        br
        | Uruguay
      p   
        span.fs-6 
          b Horarios
        | :
        br
        | Lunes a Viernes: 9:00 hrs. a 18:00 hrs.


      .mobile-only.border-top.mt-4.pt-4
        .d-block
          .w-100
            .text-center.mb-3.w-100
              a(href='https://agrooriental.uy/')
                img(src='https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png' srcset='https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png 120w, https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png 120w' width='120' height='60' sizes='120px' alt='Agrooriental')
          .w-100.text-center
            | Desarrollado para Agrooriental. Todos los derechos reservados.
      .desktop-only.align-items-center.border-top.mt-4.pt-4
        a(href='https://agrooriental.uy/')
          img.me-3(src='https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png' srcset='https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png 120w, https://agrooriental.uy/wp-content/uploads/2020/09/logo_agrooriental-e1601025470942.png 120w' width='120' height='60' sizes='120px' alt='Agrooriental')   
        | Desarrollado para Agrooriental. Todos los derechos reservados.


  script.
    var lots = !{JSON.stringify(lots)};
    const userId = #{userId};
    const activeAuctionBids = !{JSON.stringify(activeAuctionBids)};
    const activeAuctionBidsLotIds = [];
    const customerFarms = !{("farms" in customer && customer.farms.length) ? JSON.stringify(customer.farms) : "[]"};
    const customerLatLng = !{("farms" in customer && customer.farms.length) ? "{lat: " + customer.farms[0].latitude + ", lng: " + customer.farms[0].longitude + ",}" : "{lat: -32.91738186664808, lng: -55.924416022336466,}"};
    var startDates = {};
    var endDates = {};

    var countdownTimers = {};
  
  script(src='/sweetalert.min.js')
  script(src='/vendors/jquery_toast/jquery.toast.min.js')
  script(src='/majestic/owlcarousel/owl.carousel.min.js')
  //- scripts.js, search-scripts.js, chat-scripts.js, lot-template.js,
  //- carousel-scripts.js, lot-scripts.js, auctions.js, countdowns.js and
  //- toast_manager.js are combined into this one bundle at build time (see
  //- BUNDLES in scripts/build-assets.js) — same load order as before, one
  //- request instead of nine, and it's the one script set on this page that
  //- gets real top-level name obfuscation (safe here specifically because
  //- it's minified as a single unit).
  script(src=asset('/remate/bundle.js'))