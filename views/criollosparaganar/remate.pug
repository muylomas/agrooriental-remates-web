    .wrappper.mt-0
      .container
        if(lots.length)
          .auction-show.auction-show--type-one
            .panel.with-nav-tabs.panel-default
              .panel-body
                .row.tab-content(style='margin-right: 0px; margin-left: 0px; ')
                  #lotes.tab-pane.fade.in.active
                    .row
                      .col-xs-12
                        #lotes.lots.content-with-filter.mt-0
                          .hideable_tab.lots-heading
                            h2 Lotes Inscriptos
                            .filter-groups.lots-heading-filter-groups
                              a.full-width.btn-block.btn.btn-default.text-uppercase.text-center(class='btn-programa-puja-U$S', href="https://equinos.agrooriental.uy", target="_blank") Ver en Agro Oriental
                            
                          ul.lots-list.results-list.list-unstyled.content-list
                            each lotItem in lots
                              li.lots-list-item.results-list-item(id="div-item-" + lotItem.lotId, data-title='1', data-lot-id=lotItem.lotId)
                                .lot-card-item
                                  .lot-card-item-media.view.image-hover-1.no-margin
                                    if("lastPrice" in lotItem && lotItem.lastPrice && lotItem.auctionBidcustomerId)
                                      .lot-card-item-tag.status-success.bg-success
                                        a.row.text-dark(href='https://equinos.agrooriental.uy/#lote-'+lotItem.subId, target="_blank", style="color:black;")
                                          .col-md-12
                                            span(data-user-bid='false') Pre-oferta 
                                            span.value-lote-preofertas por U$S #{lotItem.lastPrice}
                                          .col-md-6
                                    else
                                      .lot-card-item-tag.bg-info
                                        a.row.text-dark(href='https://equinos.agrooriental.uy/#lote-'+lotItem.subId, target="_blank", style="color:black;")
                                          .col-md-12
                                            span A&uacute;n no tiene ofertas
                                          .col-md-6
                                    .lot-card-item-number-badge.badge-with-timer
                                      span.label.label-primary
                                        | Lote #{lotItem.subId}
                                    .product-container
                                      a.auctions_new_lote_link_changeable.a_image(href='https://equinos.agrooriental.uy/#lote-'+lotItem.subId, target="_blank")
                                        img.lte_img.img-responsive.full-width(src=lotItem.imagesArray[0], data-src=lotItem.imagesArray[0])
                                  .lot-card-item-content
                                    h4.lot-card-item-title
                                      | #{lotItem.equineName}
                                    .lot-info
                                      p.lote-rp
                                        b RP
                                        | : #{lotItem.equineRP}
                                      p.lote-categoria
                                        b #{lotItem.type}
                                      p
                                        b Alzada: 
                                        | #{lotItem.equineHeight}
                                      p
                                        b Pelo: 
                                        | #{lotItem.equineHair}
                                      p
                                        b F. Nacimiento: 
                                        | #{lotItem.equineBirth}
                                      p
                                        b Cabaña: 
                                        | #{lotItem.equineCabin}
                                        
                                  .card-footer.card-prefooter.lot-card-item-footer
                                    .lot-card-item-footer-top
                                      .lot-card-item-footer-heading
                                        h5.mt0.text-primary.lot-card-item-footer-title Ofertas en U$S #{lotItem.lastPrice}
                                    .fecha-cierre-grupo
                                      .fecha-cierre-grupo__content
                                        span.fecha-cierre-grupo__fecha
                                          b Fecha de cierre:
                                          |  
                                          span.fecha-cierre-grupo__fecha-value 2 de Agosto de 2026 a las 18:00hs.
                                    .row.m0.form-inputs
                                      .col-xs-12.mp0
                                        a.full-width.btn-block.btn.btn-default.text-uppercase.text-center.btn-programa-puja(class='btn-programa-puja-U$S', href="https://equinos.agrooriental.uy/#lote-" + lotItem.subId, target="_blank") Ofertar
                